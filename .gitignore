# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Backend secrets and generated artifacts
backend/.env
backend/.venv/
backend/data/
backend/models_probe.json
backend/**/__pycache__/

# ---------------------------------------------------------------------------
# Local experiment output. These are render artefacts from tuning the pipeline
# on this machine — hundreds of MB of mp4/png that no build or test reads.
# Root-anchored on purpose: assets/ and the platform icon sets keep their art.
# ---------------------------------------------------------------------------
/*.mp4
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.old.txt
/*.prev.txt
/configuration/
/.backup/
/__pycache__/

# Generated build output outside the root build/ dir
/android/build/
/ios/Flutter/ephemeral/

# Generated build output outside the root build/ dir
/android/build/

# ComfyUI object_info dumps and one-off API responses captured while probing
# a pod. Regenerated by backend/scripts/probe_comfy.py, never read by code.
backend/pod2.json
backend/pod_objects.json
backend/pod_stats.json
backend/req.json
backend/gem_resp.json
backend/gemini_models.json

# Template render assets. The clips are tens of MB of binary and the .hybrid
# reference is a photograph of a real person's face — neither belongs in a
# shared repo. The .points.json sidecars DO stay: they are the authored part.
backend/templates/*.mp4
backend/templates/*.webm
backend/templates/*.mov
backend/templates/*.png
backend/templates/*.jpg
