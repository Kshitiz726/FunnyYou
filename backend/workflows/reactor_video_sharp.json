{
  "1": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "wan_out.mp4",
      "force_rate": 0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1,
      "format": "None"
    },
    "_meta": {
      "title": "FY_TEMPLATE_VIDEO"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "my_face.jpg"
    },
    "_meta": {
      "title": "FY_INPUT_IMAGE"
    }
  },
  "10": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "4x-UltraSharp.pth"
    },
    "_meta": {
      "title": "upscaler"
    }
  },
  "11": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": [
        "10",
        0
      ],
      "image": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "4x"
    }
  },
  "12": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "11",
        0
      ],
      "upscale_method": "lanczos",
      "width": 960,
      "height": 1664,
      "crop": "disabled"
    },
    "_meta": {
      "title": "to 2x"
    }
  },
  "6": {
    "class_type": "ReActorFaceBoost",
    "inputs": {
      "enabled": true,
      "boost_model": "codeformer-v0.1.0.pth",
      "interpolation": "Lanczos",
      "visibility": 1.0,
      "codeformer_weight": 0.7,
      "restore_with_main_after": true
    },
    "_meta": {
      "title": "FY_FACE_BOOST"
    }
  },
  "3": {
    "class_type": "ReActorFaceSwap",
    "inputs": {
      "enabled": true,
      "input_image": [
        "12",
        0
      ],
      "source_image": [
        "2",
        0
      ],
      "swap_model": "inswapper_128.onnx",
      "facedetection": "retinaface_resnet50",
      "face_restore_model": "codeformer-v0.1.0.pth",
      "face_restore_visibility": 0.75,
      "codeformer_weight": 0.7,
      "detect_gender_input": "no",
      "detect_gender_source": "no",
      "input_faces_index": "0",
      "source_faces_index": "0",
      "console_log_level": 1,
      "face_boost": [
        "6",
        0
      ]
    },
    "_meta": {
      "title": "FY_FACE_SWAP"
    }
  },
  "5": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": [
        "3",
        0
      ],
      "frame_rate": 16,
      "loop_count": 0,
      "filename_prefix": "fy_sharp",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true,
      "crf": 16
    },
    "_meta": {
      "title": "FY_OUTPUT"
    }
  }
}