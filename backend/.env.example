# Copy to `.env` (same folder) and fill in. Gitignored — keys never leave your
# machine. Real environment variables take precedence over anything here.

# ── Previews: real AI stills of the user in each scenario ────────────────
# Free, no credit card, ~500 images/day: https://aistudio.google.com/apikey
# This one key is all it takes to turn the 40 tiles into real generated art.
GEMINI_API_KEY=

# ── Video ────────────────────────────────────────────────────────────────
# Leave both unset to keep rendering on the local fake (real playable mp4,
# no GPU). There is no free image-to-video API — pick one when you're ready:
#
#   hosted, metered in "pollen": https://enter.pollinations.ai/keys
# POLLINATIONS_API_KEY=
# VIDEO_PROVIDER=pollinations
# POLLINATIONS_VIDEO_MODEL=wan-fast     # or wan, seedance-pro, veo
#
#   your own GPU (the RunPod path — see DEPLOYMENT.md)
# VIDEO_PROVIDER=comfy
# COMFY_URL=http://<your-pod>:8188

# ── Optional ─────────────────────────────────────────────────────────────
# Bearer token the app must send. Unset means no auth — fine locally, not in
# production. Generate one with: openssl rand -hex 24
# API_KEY=

# Must be reachable *by the phone*, not by the server.
# PUBLIC_BASE_URL=http://192.168.1.68:8000
